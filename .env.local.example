NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

RESEND_API_KEY=
# Sender for admin replies to support messages: "Name <address>" on a domain verified in Resend. Leave unset to still
# save and read support messages — only the reply button needs this.
RESEND_FROM=

# Owner/admin tools (server-only, never NEXT_PUBLIC_). Service-account key JSON on ONE line, from Firebase Console →
# Project settings → Service accounts → Generate new private key. Never commit the key file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# The owner's sign-in email. The first time this (verified) account signs in, it is granted admin + owner automatically.
OWNER_EMAIL=
# Long random string (e.g. `openssl rand -hex 32`). Required only on Vercel, so its daily Cron job can call
# /api/cron/purge-history; the route refuses every request without it. Not needed to run the app locally.
CRON_SECRET=
