rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{ownerId}/{projectId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == ownerId || request.auth.token.get('admin', false) == true);
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
